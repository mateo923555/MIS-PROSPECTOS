    "@remotion/media-utils": "^4.0.547",
    "@remotion/renderer": "^4.0.547",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.547"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^18.3.32",
    "tsx": "^4.23.15",
