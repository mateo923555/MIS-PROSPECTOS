  "private": true,
  "description": "Lupa y Linterna — producción de Shorts infantiles de ciencia (Remotion + TypeScript)",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
